# ==========================================
# LURNIX Full-Stack Environment Configuration
# ==========================================

# Frontend Configuration (Vite)
# Point this to your backend proxy /api/chat endpoint
VITE_AI_PROXY_URL=http://localhost:8000/api/chat
VITE_API_BASE_URL=http://localhost:8000

# Backend Configuration (FastAPI & Google Gemini)
# Obtain your free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Port & Environment
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

