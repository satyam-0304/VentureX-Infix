{
  "name": "lurnix-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Lurnix Workspace - Full-Stack AI Learning Companion",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "backend:dev": "cd backend && .venv/Scripts/uvicorn app.main:app --port 8000 --reload",
    "backend:test": "cd backend && .venv/Scripts/pytest tests -v"
  }
}

